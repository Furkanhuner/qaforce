{
  "name": "@qaforge/cli",
  "version": "0.1.0",
  "description": "CLI for qaforge — AI-powered QA test automation",
  "bin": {
    "qaforge": "./bin/qaforge.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts --clean"
  },
  "dependencies": {
    "@qaforge/core": "workspace:*",
    "@qaforge/generator": "workspace:*",
    "@qaforge/healer": "workspace:*",
    "@qaforge/planner": "workspace:*",
    "@qaforge/providers": "workspace:*",
    "@qaforge/risk": "workspace:*",
    "@qaforge/visual": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
