{
  "name": "qaforge",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered QA test automation framework — ISTQB-aligned, provider-independent, self-healing",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm --filter \"@qaforge/*\" -r build",
    "test": "pnpm --filter \"@qaforge/core\" --filter \"@qaforge/providers\" --filter \"@qaforge/generator\" --filter \"@qaforge/healer\" --filter \"@qaforge/planner\" --filter \"@qaforge/risk\" --filter \"@qaforge/visual\" -r test",
    "lint": "eslint \"packages/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"packages/**/*.ts\" \"examples/**/*.ts\"",
    "e2e": "playwright test --config examples/demo-app/playwright.config.ts",
    "qaforge": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
